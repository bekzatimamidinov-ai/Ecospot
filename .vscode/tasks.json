{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend (FastAPI)",
      "type": "process",
      "command": "${workspaceFolder}\\backend\\.venv\\Scripts\\python.exe",
      "args": ["-m", "uvicorn", "app.main:app", "--reload", "--port", "8000"],
      "options": { "cwd": "${workspaceFolder}\\backend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Frontend (Vite)",
      "type": "process",
      "command": "npm.cmd",
      "args": ["run", "dev"],
      "options": { "cwd": "${workspaceFolder}\\frontend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Запустить всё",
      "dependsOn": ["Backend (FastAPI)", "Frontend (Vite)"],
      "problemMatcher": []
    },
    {
      "label": "Запустить тесты",
      "type": "process",
      "command": "${workspaceFolder}\\backend\\.venv\\Scripts\\python.exe",
      "args": ["-m", "pytest", "--html=../docs/test-report.html", "--self-contained-html"],
      "options": { "cwd": "${workspaceFolder}\\backend" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Пересоздать БД с демо-данными",
      "type": "process",
      "command": "${workspaceFolder}\\backend\\.venv\\Scripts\\python.exe",
      "args": ["-m", "app.seed", "--reset"],
      "options": { "cwd": "${workspaceFolder}\\backend" },
      "problemMatcher": []
    }
  ]
}
