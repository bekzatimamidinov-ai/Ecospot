{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend (FastAPI)",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe -m uvicorn app.main:app --reload --port 8000",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Frontend (Vite)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Запустить всё",
      "dependsOn": ["Backend (FastAPI)", "Frontend (Vite)"],
      "problemMatcher": []
    },
    {
      "label": "Запустить тесты",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe -m pytest --html=../docs/test-report.html --self-contained-html",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Пересоздать БД с демо-данными",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe -m app.seed --reset",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    }
  ]
}
